{
  "name": "youarehere",
  "displayName": "You Are Here",
  "description": "A VS Code extension that tells AI coding Agents where you are looking in your code — which file, cursor position, and selection.",
  "version": "0.1.0",
  "publisher": "DBinK",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0B1020",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DBinK/youarehere.git"
  },
  "homepage": "https://github.com/DBinK/youarehere#readme",
  "bugs": {
    "url": "https://github.com/DBinK/youarehere/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "context",
    "cursor",
    "selection",
    "skill"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^1.2.0"
  }
}
