{
  "name": "youarehere",
  "displayName": "You Are Here - IDE Selection to Your CLI Agent",
  "description": "A VS Code extension that hands your IDE selection to your CLI Agent — file, cursor position and selection are written to a fixed path the Agent reads. No MCP server or client config needed.",
  "version": "0.2.1",
  "publisher": "DBinK",
  "license": "MIT",
  "icon": "images/here.png",
  "galleryBanner": {
    "color": "#0B1020",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DBinK/youarehere.git"
  },
  "homepage": "https://github.com/DBinK/youarehere#readme",
  "bugs": {
    "url": "https://github.com/DBinK/youarehere/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "context",
    "cursor",
    "selection",
    "skill",
    "terminal",
    "claude-code",
    "codex"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^1.2.0"
  }
}